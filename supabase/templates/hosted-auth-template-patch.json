fffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n"
