{
  "mailer_subjects_confirmation": "Willkommen bei BlinkGo – E-Mail bestätigen",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Willkommen bei BlinkGo</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Bestätige deine E-Mail-Adresse und aktiviere dein BlinkGo-Konto.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">Willkommen bei BlinkGo</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Bestätige deine E-Mail-Adresse, um dein BlinkGo-Konto zu aktivieren.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Der Bestätigungslink ist nur für dich bestimmt und kann aus Sicherheitsgründen ablaufen.</p>\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">E-Mail bestätigen</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de – sicheren Link öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du kein BlinkGo-Konto erstellt hast, kannst du diese E-Mail sicher ignorieren.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_recovery": "BlinkGo Passwort zurücksetzen",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Passwort zurücksetzen</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Setze dein BlinkGo-Passwort sicher zurück.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">Passwort zurücksetzen</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du hast angefordert, dein BlinkGo-Passwort zurückzusetzen.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Öffne den sicheren Link und lege ein neues Passwort fest. Der Link ist nur einmal verwendbar und kann ablaufen.</p>\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">Passwort zurücksetzen</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de – sicheren Link öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du das Zurücksetzen nicht angefordert hast, kannst du diese E-Mail sicher ignorieren. Dein Passwort bleibt unverändert.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_invite": "{{ if eq .Data.invitation_kind \"driver\" }}Willkommen im BlinkGo Fahrer-Team{{ else if eq .Data.invitation_kind \"restaurant\" }}Willkommen bei BlinkGo Partner{{ else }}Deine Einladung zu BlinkGo{{ end }}",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Deine Einladung zu BlinkGo</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Richte dein sicheres BlinkGo-Konto ein.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">{{ if eq .Data.invitation_kind \"driver\" }}Willkommen im BlinkGo Fahrer-Team{{ else if eq .Data.invitation_kind \"restaurant\" }}Willkommen bei BlinkGo Partner{{ else }}Willkommen bei BlinkGo{{ end }}</h1>\n          {{ if eq .Data.invitation_kind \"driver\" }}<p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du wurdest eingeladen, dein Fahrer-Konto einzurichten.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Nimm die Einladung an und lege dein persönliches Passwort fest.</p>{{ else if eq .Data.invitation_kind \"restaurant\" }}<p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du wurdest eingeladen, dein Restaurant-Konto einzurichten.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Nimm die Einladung an und lege dein persönliches Passwort für BlinkGo Partner fest.</p>{{ else }}<p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du wurdest eingeladen, dein BlinkGo-Konto einzurichten.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Nimm die Einladung an und lege dein persönliches Passwort fest.</p>{{ end }}\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">{{ if eq .Data.invitation_kind \"driver\" }}Einladung annehmen{{ else if eq .Data.invitation_kind \"restaurant\" }}Restaurant-Konto einrichten{{ else }}Einladung annehmen{{ end }}</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de – sicheren Einladungslink öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du diese Einladung nicht erwartest, kannst du diese E-Mail sicher ignorieren.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_magic_link": "Dein sicherer BlinkGo Anmeldelink",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Dein sicherer BlinkGo Anmeldelink</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Melde dich sicher und ohne Passwort bei BlinkGo an.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">Sicher bei BlinkGo anmelden</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du hast einen sicheren Anmeldelink für BlinkGo angefordert.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Der Link ist nur einmal verwendbar und kann aus Sicherheitsgründen ablaufen.</p>\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">Bei BlinkGo anmelden</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de – sicheren Link öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du diese Anmeldung nicht angefordert hast, kannst du diese E-Mail sicher ignorieren.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_email_change": "BlinkGo E-Mail-Adresse bestätigen",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Neue E-Mail-Adresse bestätigen</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Bestätige die neue E-Mail-Adresse für dein BlinkGo-Konto.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">E-Mail-Adresse bestätigen</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Du möchtest die E-Mail-Adresse deines BlinkGo-Kontos ändern.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Bestätige <strong style=\"color:#ffffff;\">{{ .NewEmail }}</strong> als deine neue E-Mail-Adresse.</p>\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">Neue E-Mail bestätigen</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de – sicheren Link öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du diese Änderung nicht angefordert hast, bestätige sie nicht und wende dich über blinkgo.de/help an den Support.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_reauthentication": "{{ .Token }} ist dein BlinkGo Sicherheitscode",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>BlinkGo Sicherheitsbestätigung</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Verwende deinen einmaligen Sicherheitscode.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">Identität bestätigen</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Für eine sicherheitsrelevante Aktion musst du deine Identität erneut bestätigen.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Gib den folgenden einmaligen Code in BlinkGo ein. Teile ihn mit niemandem.</p>\n          <p style=\"margin:24px 0 8px;color:#FFC107;font-size:12px;line-height:16px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;\">Sicherheitscode</p><div dir=\"ltr\" style=\"margin:0 0 24px;padding:18px 12px;background:#08090B;border:1px solid #34383d;border-radius:12px;color:#ffffff;font-family:Consolas,'Courier New',monospace;font-size:32px;line-height:40px;font-weight:700;letter-spacing:8px;text-align:center;\">{{ .Token }}</div>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .SiteURL }}\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">Zurück zu BlinkGo</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .SiteURL }}\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du diese Bestätigung nicht angefordert hast, ändere dein Passwort und wende dich über blinkgo.de/help an den Support.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_password_changed_notification": "Dein BlinkGo Passwort wurde geändert",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta name=\"supported-color-schemes\" content=\"dark\">\n  <title>Dein BlinkGo Passwort wurde geändert</title>\n</head>\n<body style=\"margin:0;padding:0;background:#08090B;color:#ffffff;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;\">Sicherheitsinformation zu deinem BlinkGo-Konto.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#08090B\" style=\"width:100%;background:#08090B;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#111316\" style=\"width:100%;max-width:600px;background:#111316;border:1px solid #2a2d31;border-radius:18px;overflow:hidden;\">\n        <tr><td style=\"height:4px;background:#E10600;font-size:0;line-height:0;\">&nbsp;</td><td width=\"34%\" style=\"height:4px;background:#FFC107;font-size:0;line-height:0;\">&nbsp;</td></tr>\n        <tr><td colspan=\"2\" style=\"padding:32px 28px 26px;\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n            <tr><td align=\"center\" style=\"padding:0 0 28px;\">\n              <a href=\"https://www.blinkgo.de\" style=\"display:inline-block;text-decoration:none;\">\n                <img src=\"https://www.blinkgo.de/brand/blinkgo-email-logo.png\" width=\"220\" alt=\"BlinkGo\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;\">\n              </a>\n            </td></tr>\n          </table>\n          <h1 style=\"margin:0 0 18px;color:#ffffff;font-size:28px;line-height:1.25;font-weight:700;letter-spacing:-.02em;\">Passwort erfolgreich geändert</h1>\n          <p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Das Passwort für dein BlinkGo-Konto wurde soeben geändert.</p><p style=\"margin:0 0 16px;color:#d8dadd;font-size:16px;line-height:1.65;\">Wenn du die Änderung vorgenommen hast, musst du nichts weiter tun.</p>\n          \n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 18px;\">\n            <tr><td align=\"center\" bgcolor=\"#E10600\" style=\"border-radius:12px;background:#E10600;\">\n              <a href=\"{{ .SiteURL }}/login\" style=\"display:block;padding:15px 24px;color:#ffffff;font-size:16px;line-height:20px;font-weight:700;text-align:center;text-decoration:none;border-radius:12px;\">Bei BlinkGo anmelden</a>\n            </td></tr>\n          </table>\n          <p style=\"margin:0 0 8px;color:#8e9399;font-size:12px;line-height:1.5;\">Falls der Button nicht funktioniert:</p>\n          <p style=\"margin:0 0 24px;font-size:12px;line-height:1.55;word-break:break-word;\"><a href=\"{{ .SiteURL }}/login\" style=\"color:#FFC107;text-decoration:underline;\">blinkgo.de/login öffnen</a></p>\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-top:8px;border-top:1px solid #2a2d31;\">\n            <tr><td style=\"padding-top:20px;color:#9ca1a7;font-size:12px;line-height:1.6;\">Wenn du diese Änderung nicht vorgenommen hast, setze dein Passwort sofort zurück und wende dich über blinkgo.de/help an den Support.</td></tr>\n          </table>\n        </td></tr>\n        <tr><td colspan=\"2\" bgcolor=\"#0C0E10\" style=\"padding:22px 20px;background:#0C0E10;border-top:1px solid #24272b;text-align:center;\">\n          <p style=\"margin:0 0 6px;color:#ffffff;font-size:14px;line-height:20px;font-weight:700;\">BlinkGo</p>\n          <p style=\"margin:0 0 12px;font-size:12px;line-height:18px;\"><a href=\"https://www.blinkgo.de\" style=\"color:#FFC107;text-decoration:none;\">blinkgo.de</a></p>\n          <p style=\"margin:0;color:#858a91;font-size:12px;line-height:20px;\">\n            <a href=\"https://www.blinkgo.de/help\" style=\"color:#b8bcc1;text-decoration:underline;\">Support</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/datenschutz\" style=\"color:#b8bcc1;text-decoration:underline;\">Datenschutz</a>\n            <span aria-hidden=\"true\" style=\"color:#555a60;\">&nbsp;&nbsp;•&nbsp;&nbsp;</span>\n            <a href=\"https://www.blinkgo.de/legal/agb\" style=\"color:#b8bcc1;text-decoration:underline;\">AGB</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
