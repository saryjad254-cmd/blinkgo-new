{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/webhook-retries",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/preparation-sla",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scheduled-orders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/retail-replacements",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-drafts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/delivery-proof-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/support-attachment-retention",
      "schedule": "30 3 * * *"
    }
  ],
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_ENV": "production"
    }
  }
}
