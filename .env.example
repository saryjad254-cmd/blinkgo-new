# ============================================
# BlinkGo — Environment Variables Template
# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env (for local) or .env.local
# 2. Fill in real values from your Supabase dashboard
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. For Vercel, set these in Settings → Environment Variables
# ============================================

# ─── Supabase (REQUIRED) ──────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_REF/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ─── Supabase Direct DB (REQUIRED for .mjs scripts) ───
# The DB password is the SAME as SUPABASE_SERVICE_ROLE_KEY for Supabase projects.
# Project ref is the subdomain: https://[REF].supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=sb_secret_xxx
SUPABASE_DB_NAME=postgres

# ─── App URL (REQUIRED) ───────────────────────
# Used for OAuth redirects, password reset emails, and CSRF allow-list
# - Local:   http://localhost:3000
# - Vercel:  https://your-app.vercel.app
# - Custom:  https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Telemetry ─────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─── Google Maps (OPTIONAL) ────────────────────
# For geocoding/maps features. Safe to expose with NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Stripe (OPTIONAL for real payments) ──────
# Leave blank for cash-only mode (dev/demo)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (OPTIONAL) ──────────────────────────
# Resend for transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="BlinkGo <onboarding@resend.dev>"

# ─── Dev Bypass (NEVER set in production) ──────
# When true, allows demo accounts to bypass OTP verification
ENABLE_DEV_BYPASS=false
ENABLE_DEV_PAYMENT=true
