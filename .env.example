# =============================================================================
# BlinkGo — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your-db-password

# App URL
# Production canonical URL: https://www.blinkgo.de
# Configure blinkgo.de to redirect permanently to the canonical www host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Production: use https://blinkgo.de for the app URL and an explicit
# comma-separated allow-list containing only BlinkGo HTTPS origins.

# Real German operator/company details. Leave blank until registered and
# verified; never use invented values on public legal pages.
COMPANY_LEGAL_NAME=
COMPANY_LEGAL_FORM=
COMPANY_TRADE_NAME=BlinkGo
COMPANY_PROPRIETOR=
COMPANY_ADDITIONAL_DIRECTORS=
COMPANY_STREET=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_COUNTRY=Deutschland
COMPANY_PHONE=
COMPANY_SUPPORT_EMAIL=
COMPANY_LEGAL_EMAIL=
COMPANY_WEBSITE_URL=https://www.blinkgo.de
COMPANY_VAT_ID=
COMPANY_TAX_NUMBER=
COMPANY_COMMERCIAL_REGISTER=
COMPANY_REGISTER_COURT=
COMPANY_REGISTRATION_NUMBER=
COMPANY_SUPERVISORY_AUTHORITY=
COMPANY_EDITORIAL_RESPONSIBLE=
COMPANY_DATA_CONTROLLER=
COMPANY_DPO=
COMPANY_BUSINESS_HOURS=
COMPANY_SUPPORT_HOURS=
COMPANY_SERVICE_AREA=Wesseling, Deutschland
COMPANY_SERVICE_TYPE=
COMPANY_ARBITRATION=

# German/EU legal launch approvals. Set to APPROVED only after documented review.
LEGAL_REVIEW_STATUS=DRAFT
LEGAL_LAST_UPDATED=
ACCESSIBILITY_REVIEW_STATUS=PENDING
COOKIE_CONSENT_AUDIT_STATUS=PENDING
TRADER_VERIFICATION_STATUS=PENDING
CHECKOUT_LEGAL_REVIEW_STATUS=PENDING
PRIVACY_DPIA_STATUS=PENDING

# Stripe (use test keys for development: sk_test_*, pk_test_*, whsec_*)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
# Production launch requires matching sk_live_*, pk_live_* and whsec_* values.
ALLOW_MOCK_PAYMENTS=false

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx
EMAIL_FROM=BlinkGo <noreply@your-domain.de>
# Production: BlinkGo <auth@blinkgo.de>
# Alternative email provider (leave unset when using Resend)
SENDGRID_API_KEY=

# Web Push (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:ops@your-domain.de

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-cloud-map-id
# Production requires different restricted server/browser keys and a real Map ID.

# Secrets (use vault in production; placeholders for dev)
RESET_TOKEN_SECRET=local-dev-only-replace-in-prod
DRAFT_SIGNING_SECRET=local-dev-only-replace-in-prod
DELIVERY_PIN_SECRET=local-dev-only-replace-in-prod-with-a-separate-random-secret
CRON_SECRET=local-dev-only-replace-in-prod
METRICS_TOKEN=replace-with-a-long-random-monitoring-token

# 7G-C: Bypass rate limits in dev/test (NEVER in production)
DISABLE_RATE_LIMIT=false

LOG_LEVEL=info
LOG_OAUTH_TRACE=false
ENABLE_AUDIT_LOG=true
# Optional in development. Production reports privacy-sanitized Web Vitals automatically.
NEXT_PUBLIC_ENABLE_WEB_VITALS=false

# Local diagnostics only. Production always returns 404 even when set.
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_LOCAL_TEST_HARNESS=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Optional local acceptance accounts. Never configure these in production.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_DRIVER_EMAIL=
DEMO_DRIVER_PASSWORD=
DEMO_RESTAURANT_EMAIL=
DEMO_RESTAURANT_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
